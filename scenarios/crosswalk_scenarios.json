    "distance_to_path": "distance_to_path",
    "distance_to_crosswalk": "distance_to_crosswalk",
    "on_crosswalk": "on_crosswalk",
    "prediction_hits_crosswalk": "prediction_hits_crosswalk",
    "prediction_length": "prediction_length",
    "speed": "speed",
    "wide_safety_box_width": "wide_safety_box_width",
    "is_pedestrian": "is_pedestrian"
  },
  "rules": [
    {
      "name": "production rule",
      "code": "# Current production rule (collision_checker.py: _crosswalk_is_approaching_or_departing)\n# The real checker applies it to approach_angle when the ped is ON the\n# crosswalk, and to trajectory_approach_angle when only its prediction\n# crosses it.\n\nif on_crosswalk:\n    angle = approach_angle\nelif prediction_hits_crosswalk and trajectory_approach_angle is not None:\n    angle = trajectory_approach_angle\nelse:\n    return False\n\nif angle < 60:\n    return True\nif 180 - angle < 60 and distance_to_path < wide_safety_box_width / 2:\n    return True\nreturn False"
    },
    {
      "name": "crosswalk_axis_alignment",
      "code": "# Current production rule (collision_checker.py: _crosswalk_is_approaching_or_departing)\n# The real checker applies it to approach_angle when the ped is ON the\n# crosswalk, and to trajectory_approach_angle when only its prediction\n# crosses it.\n\nif on_crosswalk:\n    angle = approach_angle\nelif prediction_hits_crosswalk and trajectory_approach_angle is not None:\n    angle = trajectory_approach_angle\nelse:\n    return False\n\nif heading_to_crosswalk_angle >= 60 and 180 - heading_to_crosswalk_angle >= 60:\n    return False\nif angle >= 90 and distance_to_path > wide_safety_box_width / 2:\n    return False\nreturn True"
    }
  ],
