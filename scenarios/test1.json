        "pedHeadingDeg": -60,
        "speed": 1.4,
        "horizon": 3,
        "wideBox": 3.1
      }
    },
    {
      "name": "Loitering on crosswalk, walking along road",
      "expected": true,
      "params": {
        "curvature": 0,
        "cwDist": 30,
        "cwAngleDeg": 0,
        "cwLen": 12,
        "cwWid": 4,
        "pedX": 30,
        "pedY": 1.5,
        "pedHeadingDeg": 0,
        "speed": 1,
        "horizon": 3,
        "wideBox": 3.1
      }
    },
    {
      "name": "Departing, out of local path, still on crosswalk",
      "expected": false,
      "params": {
        "curvature": 0,
        "cwDist": 30,
        "cwAngleDeg": 0,
        "cwLen": 12,
        "cwWid": 4,
        "pedX": 30.99,
